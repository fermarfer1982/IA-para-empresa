[Unit]
Description=Infra Agent Web Daily Dashboard Report
Wants=network-online.target infra-agent-web.service
After=network-online.target infra-agent-web.service

[Service]
Type=oneshot
User=codexops
Group=codexops
WorkingDirectory=/opt/zabbix-codex/infra-agent-web
Environment=NODE_ENV=production
EnvironmentFile=/opt/zabbix-codex/infra-agent-web/.env.local
ExecStart=/usr/bin/node /opt/zabbix-codex/infra-agent-web/scripts/generateDailyDashboard.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

