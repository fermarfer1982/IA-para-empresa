[req]
default_bits = 4096
prompt = no
default_md = sha256
distinguished_name = dn
x509_extensions = v3_req

[dn]
CN = agente-infra.local
O = Infra Agent Internal

[v3_req]
subjectAltName = @alt_names
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth

[alt_names]
DNS.1 = agente-infra.local
DNS.2 = infra-agent.local
IP.1 = 192.168.100.124
IP.2 = 127.0.0.1
