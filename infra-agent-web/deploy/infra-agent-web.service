[Unit]
Description=Infra Agent Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codexops
Group=codexops
WorkingDirectory=/opt/zabbix-codex/infra-agent-web
Environment=NODE_ENV=production
EnvironmentFile=/opt/zabbix-codex/infra-agent-web/.env.local
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
