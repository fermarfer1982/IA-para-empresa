[Unit]
Description=Cloudflare quick tunnel for SharePoint IncidenciasTI MCP
After=network-online.target sharepoint-incidents-ti-mcp.service
Wants=network-online.target
Requires=sharepoint-incidents-ti-mcp.service

[Service]
Type=simple
User=codexops
Group=codexops
ExecStart=/usr/local/bin/cloudflared tunnel --url http://127.0.0.1:8766 --metrics 127.0.0.1:20242 --no-autoupdate
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
