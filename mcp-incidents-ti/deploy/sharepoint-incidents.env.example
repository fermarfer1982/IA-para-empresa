# Configuracion read-only Microsoft Graph para la lista IncidenciasTI.
# Copiar a /etc/zabbix-codex/sharepoint-incidents.env y rellenar secretos alli.

GRAPH_BASE_URL="https://graph.microsoft.com/v1.0"
GRAPH_SCOPE="https://graph.microsoft.com/.default"

# Opcion recomendada: credenciales de aplicacion con permisos minimos de lectura.
GRAPH_TENANT_ID="CAMBIAR"
GRAPH_CLIENT_ID="CAMBIAR"
GRAPH_CLIENT_SECRET="CAMBIAR"

# Alternativa temporal: token de acceso ya emitido. No usar en produccion permanente.
# GRAPH_ACCESS_TOKEN="CAMBIAR"

SHAREPOINT_HOSTNAME="ramiroarnedo.sharepoint.com"
SHAREPOINT_SITE_PATH="/Departamento de Informática"
SHAREPOINT_SITE_ID="ramiroarnedo.sharepoint.com,e3fa6571-ed97-4b39-8d78-a4e498324ca6,ddd6e648-3399-4ed4-879e-0c99a63c88f1"
SHAREPOINT_LIST_NAME="IncidenciasTI"
SHAREPOINT_LIST_PATH="Lists/IncidenciasTI"

# Opcional: ID real de la lista si se quiere evitar la busqueda por nombre.
# SHAREPOINT_LIST_ID="CAMBIAR"
